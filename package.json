{
  "name": "tonality",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.5.0",
    "@mui/material": "9.5.0",
    "@reduxjs/toolkit": "2.13.0",
    "firebase": "13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "react-router": "8.5.0"
  },
  "scripts": {
